# Expo SDK 57 ships react@19.2.3 while expo-router pulls react-dom@19.3.0, whose
# react peer range is ^19.3.0. npm refuses to resolve that on any subsequent
# install. React Native only ever loads react, not react-dom, so the mismatch is
# inert here. Remove this once Expo aligns the two pins.
legacy-peer-deps=true
