<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    Android 15 added mediaProcessing, which is what transcoding and transcribing
    are meant to declare. The target phone runs Android 14, where that type does
    not exist and dataSync is the nearest thing the platform offers, so both are
    declared here and the service picks at runtime.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

  <application>
    <service
      android:name="expo.modules.foregroundservice.TranscriptionService"
      android:exported="false"
      android:foregroundServiceType="mediaProcessing|dataSync" />
  </application>
</manifest>
