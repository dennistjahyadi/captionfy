{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node", "react"],
    "paths": {
      // whisper.rn 0.7.4 publishes an "exports" map with "./*" but no "." entry,
      // so TypeScript cannot resolve the package root. Metro falls back to the
      // legacy main field at runtime; this points the compiler at the same types.
      "whisper.rn": ["./node_modules/whisper.rn/lib/typescript/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "android", "ios"]
}
