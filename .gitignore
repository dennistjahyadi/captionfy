# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Built artifacts, one file per version that was actually produced. Kept on disk
# as the record of which versionCodes are spent; too big for git.
/build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# `.env` itself was never listed, which was a trap rather than a decision: the
# marketing pipeline's own docs tell you to put PEXELS_API_KEY there, and the
# file it named was the one file in this pattern git would have committed.
.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Gradle output from the local Expo modules. The two rules above are anchored to
# the repo root, so they never reached these. The source beside them is tracked.
modules/*/android/build/
modules/*/android/.cxx/
modules/*/android/.gradle/

# Phase 0 spike output pulled off device
/spike-results/

# The speech models, packed into the APK by plugins/with-bundled-models.js.
# 83 MB of weights that scripts/fetch-models.sh can put back in a minute, which
# is cheaper than every clone of this repository carrying them forever.
/assets/models/

# Test clips. Two kinds, both out of git and for opposite reasons.
#
# `accent/` is third-party licensed audio from the Speech Accent Archive, CC
# BY-NC-SA: fetch it with scripts/fetch-accent-samples.sh, do not redistribute it.
#
# `demo/` is the opposite — footage and voice this project generates for itself,
# the only clip that may appear in a store listing. It is out of git because it
# is tens of megabytes that scripts/make-demo-clip.py rebuilds byte for byte.
/test-clips/

# Competitor clips studied for the caption styles. Somebody else's footage:
# what was learned from them is written down in CLAUDE.md instead.
references/

# The TikTok renders and everything they are built from that already lives
# somewhere else. `marketing/remotion/public/` is copies — the app's own fonts
# from assets/fonts and the demo clip from test-clips — so it is a second copy
# of tracked-or-rebuildable bytes, and `sync-assets.sh` puts it back. `out/` is
# the finished MP4s, which are a build artifact like any APK.
marketing/remotion/public/
marketing/remotion/out/

# Video 01's media, in and out. All of it bytes rather than decisions, and all
# of it reproducible from something that is tracked.
#
# `input/app/` is emulator recordings of the app — `scripts/capture.mjs` takes
# them again from `shots.json`, so they are a build output that happens to need
# a booted device. `input/voice/` is the ElevenLabs read. `assets/` is anything
# fetched from outside. `out/` is renders, tens of megabytes of them.
#
# The markdown in `out/` is the exception: `voiceover_script.md` is what gets
# recorded from and `post.txt` is what gets pasted, so both are source that
# happens to be written into the output folder because the brief puts them there.
marketing/video-01-film/assets/
marketing/video-01-film/input/
marketing/video-01-film/out/*
!marketing/video-01-film/out/*.md
!marketing/video-01-film/out/post.txt

# Video 02, the same shape: recordings in, renders out, the two markdown
# files and the post text the only source that lives in `out/`.
marketing/video-02-tutorial/assets/
marketing/video-02-tutorial/input/
marketing/video-02-tutorial/out/*
!marketing/video-02-tutorial/out/*.md
!marketing/video-02-tutorial/out/post.txt

# Creator deals: real handles, real fees, real sales. The .example.csv files are
# the schema and are tracked; these two are other people's names and money.
marketing/creators/creators.csv
marketing/creators/unlocks.csv
marketing/creators/statements/
