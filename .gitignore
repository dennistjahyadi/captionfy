# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Gradle output from the local Expo modules. The two rules above are anchored to
# the repo root, so they never reached these. The source beside them is tracked.
modules/*/android/build/
modules/*/android/.cxx/
modules/*/android/.gradle/

# Phase 0 spike output pulled off device
/spike-results/

