{
  "expo": {
    "name": "Wordburn",
    "slug": "wordburn",
    "scheme": "wordburn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wordburn.app"
    },
    "android": {
      "versionCode": 1,
      "package": "com.wordburn.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F0E0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Wordburn saves the video it captioned to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["video"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wordburn reads the video you pick so it can caption it on this device."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ],
            "extraProguardRules": "-keep class com.rnwhisper.** { *; }"
          }
        }
      ],
      "expo-video",
      "expo-font",
      "expo-iap",
      "./plugins/with-bundled-models.js",
      "./plugins/with-release-signing.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
